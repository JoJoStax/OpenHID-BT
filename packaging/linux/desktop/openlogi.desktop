[Desktop Entry]
Type=Application
Name=OpenHID/BT
Comment=Universal HID and Bluetooth device management — remap buttons, DPI, ANC, and controls
Comment[es]=Control universal de dispositivos HID y Bluetooth: reasignación de botones, DPI, ANC y controles
Exec=openlogi-desktop
Icon=openlogi
Terminal=false
# Ties the running window (Wayland xdg-toplevel app_id / X11 WM_CLASS) back to
# this launcher so GNOME groups it under the OpenHID/BT icon instead of a generic
# one. Must match `openlogi_core::brand::APP_ID`, the value the GUI advertises.
StartupWMClass=org.openlogi.openlogi
Categories=Settings;HardwareSettings;AudioVideo;
Keywords=logitech;bluetooth;qcy;headset;mouse;hid;remap;dpi;anc;
StartupNotify=true
